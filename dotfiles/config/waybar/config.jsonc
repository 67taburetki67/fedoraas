{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "network", "custom/notification"],
  "custom/ws1": { "exec": "$HOME/.config/waybar/ws.sh 1", "return-type": "json", "signal": 8, "interval": "once", "format": "{}", "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'" },
  "custom/ws2": { "exec": "$HOME/.config/waybar/ws.sh 2", "return-type": "json", "signal": 8, "interval": "once", "format": "{}", "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'" },
  "custom/ws3": { "exec": "$HOME/.config/waybar/ws.sh 3", "return-type": "json", "signal": 8, "interval": "once", "format": "{}", "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'" },
  "custom/ws4": { "exec": "$HOME/.config/waybar/ws.sh 4", "return-type": "json", "signal": 8, "interval": "once", "format": "{}", "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'" },
  "custom/ws5": { "exec": "$HOME/.config/waybar/ws.sh 5", "return-type": "json", "signal": 8, "interval": "once", "format": "{}", "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'" },
  "clock": { "format": "{:%H:%M}", "tooltip": false },
  "cpu": { "format": "cpu {usage}%", "interval": 5 },
  "memory": { "format": "ram {percentage}%", "interval": 10 },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format-wifi": "{essid} · {signalStrength}% · {frequency} GHz · ↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "●",
      "none": "○",
      "dnd-notification": "◌●",
      "dnd-none": "◌",
      "inhibited-notification": "●",
      "inhibited-none": "○",
      "dnd-inhibited-notification": "◌●",
      "dnd-inhibited-none": "◌"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
