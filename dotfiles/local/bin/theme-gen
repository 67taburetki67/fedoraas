#!/usr/bin/env bash
# theme-gen <имя> <оттенок 0-360> [насыщенность 0-100, по умолчанию 50] [paws]
name="$1"; hue="$2"; sat="${3:-50}"; paws=false
[ "$4" = paws ] && paws=true
if [ -z "$name" ] || [ -z "$hue" ]; then echo "использование: theme-gen имя оттенок [насыщенность] [paws]"; exit 1; fi
T="$HOME/.config/themes"
mkdir -p "$T/themes" "$T/wallpapers/$name"
if [ -f "$T/themes/$name.env" ]; then echo "тема $name уже есть, пропускаю"; exit 0; fi
awk -v H="$hue" -v S="$sat" -v PAWS="$paws" '
function ab(x) { return x < 0 ? -x : x }
function conv(h, s, l,   c, x, m, hp) {
  h = h % 360; if (h < 0) h += 360
  if (s > 100) s = 100
  s = s / 100
  c = (1 - ab(2 * l - 1)) * s
  hp = h / 60
  x = c * (1 - ab((hp % 2) - 1))
  R = 0; G = 0; B = 0
  if (hp < 1) { R = c; G = x } else if (hp < 2) { R = x; G = c } else if (hp < 3) { G = c; B = x }
  else if (hp < 4) { G = x; B = c } else if (hp < 5) { R = x; B = c } else { R = c; B = x }
  m = l - c / 2
  R += m; G += m; B += m
}
function hx(h, s, l) { conv(h, s, l); return sprintf("%02x%02x%02x", R * 255 + 0.5, G * 255 + 0.5, B * 255 + 0.5) }
BEGIN {
  printf "BG=%s\n",       hx(H, S * 0.50, 0.050)
  printf "BG2=%s\n",      hx(H, S * 0.50, 0.065)
  printf "SURFACE=%s\n",  hx(H, S * 0.50, 0.090)
  printf "SURFACE2=%s\n", hx(H, S * 0.50, 0.120)
  printf "LINE=%s\n",     hx(H, S * 0.50, 0.170)
  printf "FAINT=%s\n",    hx(H, S * 0.45, 0.240)
  printf "MUTED=%s\n",    hx(H, S * 0.40, 0.360)
  printf "DIM=%s\n",      hx(H, S * 0.45, 0.550)
  printf "FG=%s\n",       hx(H, S, 0.780)
  printf "BRIGHT=%s\n",   hx(H, S, 0.900)
  printf "ACCENT=%s\n",   hx(H, S, 0.780)
  split("-10 0 10 -20 20 5 0", dh, " ")
  split("0.50 0.55 0.60 0.52 0.57 0.62 0.78", ll, " ")
  split("0.56 0.61 0.66 0.58 0.63 0.68 0.90", lh, " ")
  printf "C0=%s\n", hx(H, S * 0.50, 0.090)
  for (i = 1; i <= 7; i++) printf "C%d=%s\n", i, hx(H + dh[i], S * 0.55, ll[i])
  printf "C8=%s\n", hx(H, S * 0.45, 0.240)
  for (i = 1; i <= 7; i++) printf "C%d=%s\n", i + 8, hx(H + dh[i], S * 0.60, lh[i])
  conv(H, S * 0.60, 0.90)
  mx = R; if (G > mx) mx = G; if (B > mx) mx = B
  printf "TINT=\"%.2f, %.2f, %.2f\"\n", R / mx, G / mx, B / mx
  print "SAT=0.12"
  print "GRAIN=0.04"
  print "PAWS=" PAWS
}' > "$T/themes/$name.env"
echo "тема $name создана; обои кладут в $T/wallpapers/$name/"
